# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# WhatsApp Web session credentials (baileys) — real per-school login state, never committed
/.data/whatsapp-auth/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local SQLite dev database (migrations in prisma/migrations/ are still tracked)
/dev.db
/dev.db-journal

# locally stored uploads/generated files (swap for S3 in production — see src/lib/storage.ts)
/storage
